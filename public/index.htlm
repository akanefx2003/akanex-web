<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AKANE-MD V2 - Pairing & Plugin Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- ========== NAVIGATION ========== -->
  <nav class="navbar">
    <div class="container">
      <div class="nav-brand">
        <span class="logo">🌸</span>
        <span class="brand-name">AKANE-MD</span>
        <span class="version-badge">v2.0</span>
      </div>
      <div class="nav-links">
        <button class="nav-link active" data-tab="pairing">🔐 Pairing</button>
        <button class="nav-link" data-tab="plugins">📦 Plugins</button>
        <button class="nav-link" data-tab="stats">📊 Stats</button>
      </div>
    </div>
  </nav>

  <!-- ========== MAIN ========== -->
  <main>

    <!-- ===== TAB 1: PAIRING ===== -->
    <section id="tab-pairing" class="tab-content active">
      <div class="container terminal-wrapper">
        <div class="terminal">
          <!-- Terminal Header -->
          <div class="terminal-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="terminal-title">AKANE MD — Pairing Terminal</span>
          </div>

          <!-- Terminal Body -->
          <div class="terminal-body">
            <!-- Status Bar -->
            <div class="status-bar">
              <div class="status-indicator">
                <span class="pulse-dot" id="statusDot"></span>
                <span class="status-text" id="statusText">Ready</span>
              </div>
              <div class="bot-count">
                <span>🤖</span>
                <span id="connectedCount">0</span>
                <span>connected</span>
              </div>
            </div>

            <!-- Input -->
            <div class="input-section">
              <label class="input-label">📱 WhatsApp Number</label>
              <div class="input-group">
                <span class="prefix">+221</span>
                <input type="tel" id="phoneInput" placeholder="771202333" />
                <button id="pairBtn" onclick="requestPairing()">
                  <span class="btn-text">Get Code</span>
                  <span class="btn-spinner" style="display:none;">⟳</span>
                </button>
              </div>
            </div>

            <!-- Status Container -->
            <div id="statusContainer" class="status-container" style="display:none;">
              <div class="status-card">
                <div class="status-icon" id="statusIcon">⏳</div>
                <div class="status-message" id="statusMessage">Processing...</div>
                <div class="progress-bar">
                  <div class="progress-fill" id="progressFill"></div>
                </div>
                <div class="progress-text" id="progressText">0%</div>
              </div>
            </div>

            <!-- Code Display -->
            <div id="codeDisplay" class="code-display-wrapper" style="display:none;">
              <div class="code-label">🔑 Ton code de connexion</div>
              <div class="code-display" id="pairingCode">----</div>
              <button class="copy-btn" onclick="copyCode()">📋 Copier le code</button>
              <div class="expire">⏱ Expire dans 60 secondes</div>
              <div class="steps">
                <span>01.</span> Ouvre WhatsApp sur ton téléphone<br />
                <span>02.</span> Paramètres → Appareils liés<br />
                <span>03.</span> Lier un appareil → Lier avec un numéro<br />
                <span>04.</span> Entre le code ci-dessus
              </div>
            </div>

            <!-- Connected -->
            <div id="connectedDisplay" style="display:none;">
              <div class="connected-title">✅ Bot connecté avec succès !</div>
              <div class="connected-sub">
                <span id="connectedNumber">+221XXXXXXXX</span> est maintenant actif 24h/24.
                <br />Vérifie ton WhatsApp, un message de confirmation a été envoyé.
              </div>
            </div>

            <!-- Features -->
            <div class="features-grid">
              <div class="feature-card">
                <span class="feature-icon">⚡</span>
                <h3>Pairing Instantané</h3>
                <p>Connecte ton WhatsApp en quelques secondes</p>
              </div>
              <div class="feature-card">
                <span class="feature-icon">🔒</span>
                <h3>Sécurisé</h3>
                <p>Connexion chiffrée et protégée</p>
              </div>
              <div class="feature-card">
                <span class="feature-icon">📦</span>
                <h3>Système de Plugins</h3>
                <p>Installe des plugins facilement</p>
              </div>
            </div>

            <!-- Links -->
            <div class="links-section">
              <a href="https://whatsapp.com/channel/0029VbCrJRnGufIyytPXy606" target="_blank" class="link-btn whatsapp">📢 Channel</a>
              <a href="https://github.com/akanefx2003/AKANE_MD" target="_blank" class="link-btn github">💻 GitHub</a>
              <a href="https://youtube.com/@akanefx-j3k9o" target="_blank" class="link-btn youtube">🎥 YouTube</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TAB 2: PLUGINS ===== -->
    <section id="tab-plugins" class="tab-content">
      <div class="container">
        <div class="plugins-header">
          <h2>📦 Plugin Store</h2>
          <p>Découvre et installe des plugins pour ton bot</p>
          <div class="plugin-search">
            <input type="text" id="pluginSearch" placeholder="🔍 Rechercher un plugin..." />
            <select id="pluginFilter">
              <option value="all">Toutes les catégories</option>
              <option value="utils">🛠 Utils</option>
              <option value="media">🎬 Media</option>
              <option value="ai">🧠 AI</option>
              <option value="games">🎮 Jeux</option>
              <option value="tools">🔧 Tools</option>
            </select>
          </div>
        </div>
        <div id="pluginGrid" class="plugin-grid">
          <!-- Chargé dynamiquement -->
        </div>
      </div>
    </section>

    <!-- ===== TAB 3: STATS ===== -->
    <section id="tab-stats" class="tab-content">
      <div class="container">
        <div class="stats-dashboard">
          <div class="stat-card">
            <div class="stat-icon">🤖</div>
            <div class="stat-info">
              <h3>Bots Connectés</h3>
              <span id="statBots">0</span>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-info">
              <h3>Plugins</h3>
              <span id="statPlugins">0</span>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">⏱️</div>
            <div class="stat-info">
              <h3>Uptime</h3>
              <span id="statUptime">0s</span>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">💾</div>
            <div class="stat-info">
              <h3>RAM</h3>
              <span id="statRam">0MB</span>
            </div>
          </div>
        </div>
        <div class="system-info">
          <h3>📊 Informations Système</h3>
          <pre id="systemInfo">Chargement...</pre>
        </div>
      </div>
    </section>

  </main>

  <!-- ========== FOOTER ========== -->
  <footer class="footer">
    <div class="container">
      <p>© 2024 AKANE-MD V2 · Made with ❤️ by <strong>AKANE Team</strong></p>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>